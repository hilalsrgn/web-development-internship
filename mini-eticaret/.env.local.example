# Bu dosyayı kopyalayıp ".env.local" adıyla kaydet, sonra gerçek değerleri gir.
# .env.local git'e gönderilmez (bkz. .gitignore) — gizli bilgiler asla commit edilmemeli.

# MongoDB Atlas bağlantı adresin (Atlas hesabı > Connect > Drivers)
MONGODB_URI=mongodb+srv://<kullanici>:<sifre>@<cluster-adresi>/mini-eticaret
#
# Not: Bazı ağlarda "mongodb+srv://" gerektirdiği özel DNS sorgusu (SRV kaydı)
# aralıklı olarak başarısız oluyor ("querySrv ECONNREFUSED" hatası). Bu
# oluyorsa, Atlas > Database > Connect > Drivers ekranında "SRV kaydı
# olmadan bağlan" seçeneğiyle sunucu adreslerini açıkça yazan alternatif
# formatı kullanabilirsin — o format bu DNS sorgusuna hiç ihtiyaç duymaz.

# JWT imzalama anahtarı — rastgele, uzun bir metin olsun (örn. openssl rand -base64 32)
JWT_SECRET=buraya-uzun-ve-rastgele-bir-anahtar-yaz

# Vercel Blob — ürün görselleri buraya yükleniyor (bkz. gun-08-raporu.md)
# Vercel Dashboard > proje > Storage > Blob store oluştur > .env.local'a kopyala
BLOB_READ_WRITE_TOKEN=
